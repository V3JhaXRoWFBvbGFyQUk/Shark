#!/usr/bin/env python3
"""One-line description of what this tool does and when SHARK should use it."""

import argparse
import json
import sys


def run(args: argparse.Namespace) -> dict:
    """Do the work and return a structured result."""
    return {"ok": True, "input": args.input}


def main() -> int:
    parser = argparse.ArgumentParser(description="One-line description of the tool")
    parser.add_argument("input", help="Describe the required input")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    args = parser.parse_args()

    try:
        result = run(args)
    except Exception as exc:  # keep failures explicit and machine-readable
        result = {"ok": False, "error": str(exc)}

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(json.dumps(result, indent=2) if not result.get("ok") else result)
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
